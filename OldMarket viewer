// ---------- Загрузка с таймаутом ----------
async function fetchPage(mode, page, timeoutMs = FETCH_TIMEOUT_MS){
  const url = SITE + MODES[mode] + "&page=" + page;
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const r = await fetch(url, { credentials:"omit", signal: ctrl.signal });
    clearTimeout(timer);
    if (!r.ok) throw new Error("HTTP " + r.status);
    // Возвращаем и текст, и финальный URL (после редиректа)
    return { html: await r.text(), finalUrl: r.url || url, ok: true };
  } catch (e) {
    clearTimeout(timer);
    // Пробуем прокси (без таймаута на прокси, но с общим лимитом)
    try {
      const p = "https://api.allorigins.win/raw?url=" + encodeURIComponent(url);
      const ctrl2 = new AbortController();
      const t2 = setTimeout(() => ctrl2.abort(), timeoutMs);
      const r2 = await fetch(p, { signal: ctrl2.signal });
      clearTimeout(t2);
      if (!r2.ok) throw new Error("proxy " + r2.status);
      return { html: await r2.text(), finalUrl: url, ok: true };
    } catch (e2) {
      return { html: null, finalUrl: url, ok: false, error: e.message };
    }
  }
}

// ---------- Определение числа страниц ----------
function detectFromText(html){
  const m = html.match(/Страница\s+\d+\s+из\s+(\d+)/i);
  if (m) return parseInt(m[1], 10);
  const m2 = html.match(/\bиз\s+(\d+)\b/i);
  if (m2) return parseInt(m2[1], 10);
  return null;
}

// Извлекаем номер страницы из URL (после редиректа)
function pageFromUrl(url){
  try {
    const u = new URL(url);
    const p = u.searchParams.get("page");
    if (p) {
      const n = parseInt(p, 10);
      if (!isNaN(n) && n > 0) return n;
    }
  } catch {}
  // Иногда редирект может быть на другой формат — пробуем найти "page=N" в строке
  const m = url.match(/[?&]page=(\d+)/i);
  if (m) return parseInt(m[1], 10);
  return null;
}

// Основная функция: определяем последнюю страницу
async function determineLastPage(mode){
  log("→ определяю число страниц (способ 1: надпись «Страница X из Y»)...");
  const first = await fetchPage(mode, 1, FETCH_TIMEOUT_MS);

  // Если первая страница вообще не загрузилась — сразу пробуем probe
  if (first.ok && first.html) {
    const fromText = detectFromText(first.html);
    if (fromText) {
      log("✓ способ 1 сработал: " + fromText + " страниц");
      return { lastPage: fromText, firstHtml: first.html, firstUrl: first.finalUrl };
    }
    log("⚠ надпись не найдена, пробую способ 2 (probe page=999999)...");
  } else {
    log("⚠ первая страница не загрузилась (" + (first.error || "таймаут") + "), пробую probe...");
  }

  // Способ 2: запрашиваем заведомо большую страницу
  const probe = await fetchPage(mode, PROBE_PAGE, FETCH_TIMEOUT_MS);
  if (!probe.ok || !probe.html) {
    // Если и probe не удался — fallback по разделу
    const fallback = mode === "games" ? 96 : 67;
    log("✗ probe не удался, беру fallback: " + fallback);
    return { lastPage: fallback, firstHtml: first.ok ? first.html : null, firstUrl: first.finalUrl };
  }

  // Пытаемся вытащить номер из финального URL
  let fromUrl = pageFromUrl(probe.finalUrl);
  if (fromUrl && fromUrl !== PROBE_PAGE) {
    log("✓ способ 2 сработал (URL): последняя страница = " + fromUrl);
    // Если первая страница не загрузилась, но probe дал HTML — используем его как «первую»
    return { lastPage: fromUrl, firstHtml: first.ok ? first.html : null, firstUrl: first.finalUrl, probeHtml: probe.html };
  }

  // Если редиректа не было (URL остался с page=999999) — пробуем найти номер в тексте
  const fromProbeText = detectFromText(probe.html);
  if (fromProbeText) {
    log("✓ способ 2 сработал (текст probe): " + fromProbeText);
    return { lastPage: fromProbeText, firstHtml: first.ok ? first.html : null, firstUrl: first.finalUrl };
  }

  // Если страница с page=999999 вернула пустоту или ошибку — возможно, сайт не редиректит
  // Тогда сканируем вручную вверх/вниз — но это дорого. Fallback:
  const fallback = mode === "games" ? 96 : 67;
  log("⚠ не удалось определить, беру fallback: " + fallback);
  return { lastPage: fallback, firstHtml: first.ok ? first.html : null, firstUrl: first.finalUrl };
}

// ---------- Парсинг ----------
function parseItems(html, pageNum){
  const doc = new DOMParser().parseFromString(html, "text/html");
  const lines = (doc.body ? doc.body.innerText : "").split("\n").map(s=>s.trim()).filter(Boolean);
  const items = [];
  for (let i=0;i<lines.length;i++){
    const m = lines[i].match(/^API\s+(\d+)\s*\(/);
    if (!m) continue;
    const api = parseInt(m[1],10);
    let name=null, rating=null;
    for (let j=i-1;j>=0 && j>=i-6;j--){
      const l=lines[j];
      const rm=l.match(/^Рейтинг:\s*([\d.]+)/);
      if (rm){ rating=parseFloat(rm[1]); continue; }
      if (/^Скачиваний:/.test(l)||/^API\s/.test(l)) continue;
      name=l; break;
    }
    if (name) items.push({ name, rating, api, foundOnPage: pageNum });
  }
  return items;
}

// ---------- ARMv6 ----------
const BETA_RE = /\b(beta|alpha|demo|preview|test|early access|бета|альфа|демо|тест)\b/i;
const KNOWN_ARMV7 = [/minecraft/i,/subway surf/i,/geometry dash/i,/plants vs zombies/i,/temple run/i,/cut the rope/i,/fruit ninja/i,/angry birds/i,/doodle jump/i,/hungry shark/i,/modern combat/i,/real racing/i,/need for speed/i,/asphalt/i];
