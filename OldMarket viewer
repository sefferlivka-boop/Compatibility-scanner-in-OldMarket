function detectGenre(name){
  for (const [re, genre] of GENRE_MAP) if (re.test(name)) return genre;
  return null;
}

// ---------- Кэш и Настройки ----------
let cache = { games: { pages: {} }, apps: { pages: {} } };
let prefs = { genreStats: {}, optIcons: false, optRecommend: true };

function loadData() {
  try {
    const c = localStorage.getItem(CACHE_KEY);
    if (c) cache = JSON.parse(c);
    const p = localStorage.getItem(PREFS_KEY);
    if (p) prefs = { ...prefs, ...JSON.parse(p) };
  } catch (e) { console.log("Ошибка загрузки локальных данных"); }
}
function saveCache() { localStorage.setItem(CACHE_KEY, JSON.stringify(cache)); }
function savePrefs() { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); }

// Применяем настройки
const chkIcons = document.getElementById("optIcons");
const chkRecommend = document.getElementById("optRecommend");
if(chkIcons) {
  chkIcons.checked = prefs.optIcons;
  chkIcons.addEventListener("change", (e) => { prefs.optIcons = e.target.checked; savePrefs(); renderTable(); });
}
if(chkRecommend) {
  chkRecommend.checked = prefs.optRecommend;
  chkRecommend.addEventListener("change", (e) => { prefs.optRecommend = e.target.checked; savePrefs(); updateRecommended(); });
}

function trackGenreClick(genre) {
  if (!genre || genre === "—") return;
  prefs.genreStats[genre] = (prefs.genreStats[genre] || 0) + 1;
  savePrefs();
}

// ---------- Состояние ----------
const seen = new Set();
const all = [];
let total=0, okPages=0, failPages=0, newGames=0, cachedGames=0;
let isCancelled = false;

// ---------- UI ----------
const $ = id => document.getElementById(id);
const logEl = $("log");
function log(m){ logEl.textContent += m+"\n"; logEl.scrollTop = logEl.scrollHeight; }
const sleep = ms => new Promise(r => setTimeout(r, ms));

function updatePresetInfo(){
  const k = $("preset").value;
  if (k === "custom") { $("customPanel").classList.remove("hidden"); $("presetInfo").textContent = "— введите характеристики ниже"; return; }
  $("customPanel").classList.add("hidden");
  const p = PRESETS[k];
  $("presetInfo").textContent = p ? p.note : "";
}
$("preset").addEventListener("change", updatePresetInfo);

function getPreset(){
  const k = $("preset").value;
  if (k === "custom") {
    const armv6 = $("cArm").value === "v6";
    const apiMax = parseInt($("cApi").value, 10);
    const vendor = $("cVendor").value || "Custom";
    const cpu = $("cCpu").value || ($("cFreq").value + " MHz");
    return { name: vendor + " (" + cpu + ")", apiMax, armv6 };
  }
  return { key:k, ...PRESETS[k] };
}

// ---------- Умная загрузка ----------
async function fetchWithTimeout(url, ms){
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), ms);
  try {
    const r = await fetch(url, { credentials:"omit", signal: ctrl.signal });
    clearTimeout(t);
    if (!r.ok) throw new Error("HTTP " + r.status);
    return { ok:true, text: await r.text(), url: r.url };
  } catch (e) {
    clearTimeout(t);
    return { ok:false, error: e.message };
  }
}

async function fetchPageSmart(mode, page, pIndex, totalPages){
  const url = SITE + MODES[mode] + "&page=" + page;
  
  let maxAttempts = 5;
  let timeoutMs = 5000;

  if (pIndex < 5) { maxAttempts = 10; timeoutMs = 7000; } 
  else if (pIndex > totalPages * 0.8) { maxAttempts = 2; timeoutMs = 3000; } 
  
  if (failPages > 3) { maxAttempts = Math.max(2, maxAttempts - 3); }

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    if (isCancelled) return null;
    const res = await fetchWithTimeout(url, timeoutMs);
    if (res.ok) return res.text;
    
    try {
      const proxy = "https://api.allorigins.win/raw?url=" + encodeURIComponent(url);
      const res2 = await fetchWithTimeout(proxy, timeoutMs);
      if (res2.ok) return res2.text;
    } catch {}

    log(`  ⚠ Попытка ${attempt}/${maxAttempts} не удалась...`);
    await sleep(500);
  }
  return null;
}

// ---------- Определение страниц ----------
function detectFromText(html){
  const m = html.match(/Страница\s+\d+\s+из\s+(\d+)/i);
  if (m) return parseInt(m[1], 10);
  const m2 = html.match(/\bиз\s+(\d+)\b/i);
  if (m2) return parseInt(m2[1], 10);
  return null;
}

async function determineLastPage(mode){
  log("→ ищу «Страница X из Y»...");
  const r1 = await fetchPageSmart(mode, 1, 1, 100);
  if (!r1) { log("✗ первая страница не загрузилась"); return null; }
  
  const fromText = detectFromText(r1);
  if (fromText){ log("✓ найдено в тексте: " + fromText); return fromText; }

  log("→ текст не помог, пробую большой номер страницы...");
  const r2 = await fetchPageSmart(mode, BIG_PAGE, 1, 100);
  if (!r2) { log("✗ большой номер не сработал"); return null; }
  
  const fromText2 = detectFromText(r2);
  if (fromText2){ log("✓ по тексту ответа: " + fromText2); return fromText2; }

  log("✗ не удалось определить число страниц");
  return null;
}

// ---------- Парсинг (ИСПРАВЛЕН) ----------
function parseItems(html, pageNum){
  try {
    const doc = new DOMParser().parseFromString(html, "text/html");
    const lines = (doc.body ? doc.body.innerText : "").split("\n").map(s=>s.trim()).filter(Boolean);
    const items = [];
    for (let i=0;i<lines.length;i++){
      const m = lines[i].match(/^API\s+(\d+)\s*\(/);
      if (!m) continue;
      const api = parseInt(m[1],10);
      let name=null, rating=null;
      for (let j=i-1;j>=0 && j>=i-6;j--){
        const l=lines[j];
        const rm=l.match(/^Рейтинг:\s*([\d.]+)/);
        if (rm){ rating=parseFloat(rm[1]); continue; }
        if (/^Скачиваний:/.test(l)||/^API\s/.test(l)) continue;
        name=l; break;
      }
      if (name) items.push({ name, rating, api, foundOnPage: pageNum, iconUrl: null, gameUrl: null });
    }
    
    // Попытка найти иконки и ссылки через DOM, если есть имена
    if (items.length > 0) {
      const allLinks = doc.querySelectorAll('a');
      for (const item of items) {
         // Ищем ссылку, текст которой содержит название игры (первые 10 символов)
         const shortName = item.name.substring(0, 10).toLowerCase();
         for (const a of allLinks) {
            if (a.textContent.toLowerCase().includes(shortName)) {
                item.gameUrl = a.href;
                const img = a.querySelector('img');
                if (img) item.iconUrl = img.src;
                break;
            }
         }
      }
    }
    return items;
  } catch (e) {
    console.error("Ошибка парсинга:", e);
    return [];
  }
}

// ---------- ARMv6 ----------
const BETA_RE = /\b(beta|alpha|demo|preview|test|early access|бета|альфа|демо|тест)\b/i;
const KNOWN_ARMV7 = [/minecraft/i,/subway surf/i,/geometry dash/i,/plants vs zombies/i,/temple run/i,/cut the rope/i,/fruit ninja/i,/angry birds/i,/doodle jump/i,/hungry shark/i,/modern combat/i,/real racing/i,/need for speed/i,/asphalt/i];
const KNOWN_X8_WORK = [/cuttheburmalda/i,/burmaldamods/i,/peKORA/i,/говорящий бен/i,/говорящий том/i,/говорящая анджела/i,/говорящий ларри/i,/говорящий санта/i,/talking roby/i,/talking tom bubble/i,/retro brawl/i,/exploration/i,/rover craft/i,/doodle army/i,/джинджер/i,/говорящий хиппо/i,/angry viking/i,/train crisis/i,/inertia/i,/escape velocity/i];
function looksHeavy(n){ return /3d|hd|race|racing|shooter|fps|mmo|online|battle royale|pubg|asphalt|need for speed|modern combat/i.test(n.toLowerCase()); }
function classifyArmv6(name, api){
  if (api>8) return "red";
  if (api<8) return looksHeavy(name)?"blue":"green";
  for (const re of KNOWN_ARMV7) if (re.test(name)) return "red";
  for (const re of KNOWN_X8_WORK) if (re.test(name)) return "green";
  if (looksHeavy(name)) return "yellow";
  return "blue";
}

// ---------- Отрисовка ----------
function armLabel(a){ return a==="green"?"🟢 пойдёт":a==="yellow"?"🟡 может":a==="red"?"🔴 нет":"🔵 ?"; }

function smartSort(a, b) {
  const isDigitSym = (str) => /^[^a-zA-Zа-яА-Я]/.test(str);
  const isEng = (str) => /^[a-zA-Z]/.test(str);
  const aN = a.name.trim(), bN = b.name.trim();
  
  if (isDigitSym(aN) && !isDigitSym(bN)) return -1;
  if (!isDigitSym(aN) && isDigitSym(bN)) return 1;
  
  if (isEng(aN) && !isEng(bN)) return -1;
  if (!isEng(aN) && isEng(bN)) return 1;
  
  return aN.localeCompare(bN);
}

function renderTable(){
  const mode = $("mode").value;
  const category = $("category").value;
  const preset = getPreset();
  const searchQ = $("searchInput").value.toLowerCase().trim();
  const sortBy = $("sortSelect").value;

  const tb = document.querySelector("#result tbody");
  tb.innerHTML = "";

  let filtered = all.filter(g => g.api <= preset.apiMax && (category === "all" || g.genre === category));
  
  if (searchQ) {
    filtered = filtered.filter(g => g.name.toLowerCase().includes(searchQ));
  }

  if (sortBy === "rating") {
    filtered.sort((a,b) => (b.rating||0) - (a.rating||0));
  } else if (sortBy === "name") {
    filtered.sort(smartSort);
  }

  for (const g of filtered) {
    const tr = document.createElement("tr");
    tr.className = g.arm === "green" ? "green" : g.arm === "yellow" ? "yellow" : g.arm === "red" ? "red" : "blue";
    const r = g.rating!=null ? g.rating.toFixed(1) : "—";
    const star = (g.rating||0)>=4 ? " ⭐" : "";
    const arm = preset.armv6 ? armLabel(g.arm) : "—";
    
    const link = g.gameUrl ? g.gameUrl : SITE + MODES[mode] + "&page=" + g.foundOnPage;
    
    let iconHtml = "";
    if (prefs.optIcons && g.iconUrl) {
      iconHtml = `<img src="${g.iconUrl}" style="width:20px; height:20px; vertical-align:middle; margin-right:6px; border-radius:4px;" onerror="this.style.display='none'">`;
    }

    tr.innerHTML = `
      <td class="${g.rating>=4?'good':''}">${iconHtml}<a href="${link}" target="_blank" onclick="trackGenreClick('${g.genre}')">${g.name}</a>${star}</td>
      <td class="col-hide-mobile">${g.genre || "—"}</td>
      <td>${r}</td>
      <td>${g.api}</td>
      <td>${arm}</td>
      <td><a href="${SITE + MODES[mode] + "&page=" + g.foundOnPage}" target="_blank">стр. ${g.foundOnPage}</a></td>
    `;
    tb.appendChild(tr);
  }
}

function updateRecommended(){
  const wrap = $("recommendedWrap");
  const tb = $("recBody");
  
  if (!prefs.optRecommend || Object.keys(prefs.genreStats).length === 0) {
    wrap.classList.add("hidden");
    return;
  }

  let topGenre = null;
  let maxCount = 0;
  for (const [g, count] of Object.entries(prefs.genreStats)) {
    if (count > maxCount) { maxCount = count; topGenre = g; }
  }

  const preset = getPreset();
  const recs = all.filter(g => g.genre === topGenre && g.api <= preset.apiMax).slice(0, 5); 

  if (recs.length === 0) { wrap.classList.add("hidden"); return; }
  
  wrap.classList.remove("hidden");
  tb.innerHTML = "";
  for (const g of recs) {
    const tr = document.createElement("tr");
    const link = g.gameUrl ? g.gameUrl : SITE + MODES[$("mode").value] + "&page=" + g.foundOnPage;
    tr.innerHTML = `
      <td><a href="${link}" target="_blank" onclick="trackGenreClick('${g.genre}')">${g.name}</a></td>
      <td class="col-hide-mobile">${g.genre}</td>
      <td>${g.rating ? g.rating.toFixed(1) : "—"}</td>
      <td>${g.api}</td>
      <td>${getPreset().armv6 ? armLabel(g.arm) : "—"}</td>
      <td><a href="${SITE + MODES[$("mode").value] + "&page=" + g.foundOnPage}" target="_blank">стр. ${g.foundOnPage}</a></td>
    `;
    tb.appendChild(tr);
  }
}

function updateSummary(preset, category, mode, newG = 0, cachedG = 0){
  let matching = all.filter(g => g.api <= preset.apiMax);
  if (category !== "all") matching = matching.filter(g => g.genre === category);
  const good = matching.filter(g => (g.rating||0)>=4);
  const green = matching.filter(g => g.arm==="green");
  const yellow = matching.filter(g => g.arm==="yellow");

  let html = `<b>Раздел:</b> ${mode==="games"?"Игры":"Приложения"} | `;
  html += `<b>Категория:</b> ${category} | `;
  html += `<b>Телефон:</b> ${preset.name} (API ≤ ${preset.apiMax})<br>`;
  html += `Страниц: ${okPages} ок, ${failPages} ошибок<br>`;
  html += `Уникальных всего: <b>${total}</b> (из кэша: ${cachedG}, новых: ${newG})<br>`;
  html += `Подходят (API + категория): <b>${matching.length}</b><br>`;
  html += `«Хорошие» (≥4★): <b>${good.length}</b><br>`;
  if (preset.armv6){
    html += `🟢 ARMv6 точно: <b>${green.length}</b><br>`;
    html += `🟡 ARMv6 может: <b>${yellow.length}</b><br>`;
  }
  $("summary").innerHTML = html;
}

const GROUPS = [
  {label:"Android 1.6 и ниже", color:"#888",    test:a=>a<=4},
  {label:"Android 2.1+",       color:"#e67e22", test:a=>a===7},
  {label:"Android 2.2+",       color:"#27ae60", test:a=>a===8},
  {label:"Android 2.3+",       color:"#2980b9", test:a=>a===9||a===10},
  {label:"Android 4.0+ и выше",color:"#8e44ad", test:a=>a>=14}
];
function drawChart(){
  const c = $("chart"), ctx = c.getContext("2d");
  const W=c.width, H=c.height; ctx.clearRect(0,0,W,H);
  const counts = GROUPS.map(gr => all.filter(g=>gr.test(g.api)).length);
  const maxC = Math.max(1,...counts);
  const pL=60,pR=20,pT=20,pB=60, pw=W-pL-pR, ph=H-pT-pB;

  ctx.strokeStyle="#999"; ctx.beginPath(); ctx.moveTo(pL,pT); ctx.lineTo(pL,H-pB); ctx.lineTo(W-pR,H-pB); ctx.stroke();
  ctx.fillStyle="#666"; ctx.font="12px sans-serif"; ctx.textAlign="right";
  for(let i=0;i<=5;i++){ const v=Math.round(maxC*i/5); const y=H-pB-ph*i/5; ctx.fillText(v,pL-6,y+4); ctx.strokeStyle="#eee"; ctx.beginPath(); ctx.moveTo(pL,y); ctx.lineTo(W-pR,y); ctx.stroke(); }
  ctx.textAlign="center"; ctx.fillStyle="#333";
  const sx = pw/(GROUPS.length-1||1);
  GROUPS.forEach((gr,i)=>{ const x=pL+sx*i; const w=gr.label.split(" "); ctx.fillText(w[0],x,H-pB+18); ctx.fillText(w.slice(1).join(" "),x,H-pB+34); });
  ctx.strokeStyle="#27ae60"; ctx.lineWidth=2; ctx.beginPath();
  GROUPS.forEach((gr,i)=>{ const x=pL+sx*i; const y=H-pB-ph*counts[i]/maxC; i?ctx.lineTo(x,y):ctx.moveTo(x,y); });
  ctx.stroke();
  GROUPS.forEach((gr,i)=>{ const x=pL+sx*i; const y=H-pB-ph*counts[i]/maxC; ctx.fillStyle=gr.color; ctx.beginPath(); ctx.arc(x,y,5,0,Math.PI*2); ctx.fill(); ctx.fillStyle="#000"; ctx.font="bold 12px sans-serif"; ctx.fillText(counts[i],x,y-10); });
  ctx.fillStyle="#000"; ctx.font="bold 14px sans-serif"; ctx.textAlign="left"; ctx.fillText("Количество по версиям Android",pL,pT-4);
}

async function run(){
  const mode = $("mode").value;
  const category = $("category").value;
  const preset = getPreset();

  $("start").disabled = true;
  $("cancel").classList.remove("hidden");
  $("progressWrap").style.display = "block";
  $("progressBar").style.width = "0%";
  $("progressBar").style.background = "var(--btn)";
  $("progressText").textContent = "Определение страниц...";
  $("resultWrap").style.display = "none";
  
  logEl.textContent = ""; $("summary").innerHTML = "";
  seen.clear(); all.length = 0;
  total=0; okPages=0; failPages=0; newGames=0; cachedGames=0;
  isCancelled = false;

  const lastPage = await determineLastPage(mode);
  if (!lastPage || isCancelled){
    if (!isCancelled) log("✗ не удалось определить число страниц");
    $("start").disabled = false;
    $("cancel").classList.add("hidden");
    $("progressText").textContent = isCancelled ? "Отменено" : "Ошибка";
    return;
  }
  
  log("Всего страниц: " + lastPage);
  if (!cache[mode].pages) cache[mode].pages = {};

  for (let p=1; p<=lastPage; p++){
    if (isCancelled) break;

    const pageKey = "p" + p;
    let items = [];
    let isCached = false;

    if (cache[mode].pages[pageKey]) {
      items = cache[mode].pages[pageKey];
      isCached = true;
      log(`→ ${p}/${lastPage}... (кэш)`);
    } else {
      log(`→ ${p}/${lastPage}... (загрузка)`);
      const html = await fetchPageSmart(mode, p, p, lastPage);
      if (!html){ failPages++; await sleep(200); continue; }
      
      items = parseItems(html, p);
      if (!items.length){ failPages++; await sleep(200); continue; }
      cache[mode].pages[pageKey] = items;
    }
    
    okPages++;
    for (const g of items){
      const key=g.name.toLowerCase().trim();
      if (seen.has(key)) continue;
      seen.add(key);
      if (BETA_RE.test(g.name)) continue;
      
      g.genre = detectGenre(g.name);
      g.arm = classifyArmv6(g.name, g.api);
      all.push(g); total++;
      
      if (isCached) cachedGames++; else newGames++;
    }
    
    const percent = Math.round((p / lastPage) * 100);
    $("progressBar").style.width = percent + "%";
    $("progressText").textContent = `Сканирование... ${p} / ${lastPage} (${percent}%)`;
    updateSummary(preset, category, mode, newGames, cachedGames);
    
    if (!isCached) await sleep(200);
  }
  
  saveCache();
  
  $("resultWrap").style.display = "block";
  renderTable();
  updateRecommended();
  drawChart();
  updateSummary(preset, category, mode, newGames, cachedGames);
  
  $("start").disabled = false;
  $("cancel").classList.add("hidden");
  $("progressBar").style.width = isCancelled ? `${Math.round((okPages/lastPage)*100)}%` : "100%";
  if (!isCancelled) $("progressBar").style.background = "#27ae60";
  $("progressText").textContent = isCancelled ? "Сканирование отменено" : `Готово! Страниц: ${lastPage}`;
}

$("start").addEventListener("click", run);
$("cancel").addEventListener("click", () => {
  isCancelled = true;
  log("🛑 Отмена...");
});
$("searchInput").addEventListener("input", renderTable);
$("sortSelect").addEventListener("change", renderTable);
$("mode").addEventListener("change", renderTable);
$("category").addEventListener("change", renderTable);
$("preset").addEventListener("change", renderTable);

loadData();
updatePresetInfo();
</script>
