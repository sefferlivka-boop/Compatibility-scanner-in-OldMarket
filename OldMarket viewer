<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>OldMarket — игры и приложения</title>
<style>
  :root {
    --bg: #ffffff; --fg: #222222; --border: #cccccc; --panel: #f9f9f9;
    --green: #d4edda; --yellow: #fff3cd; --red: #f8d7da; --blue: #d1ecf1; --good: #fff3cd;
    --btn: #0066cc; --btn-text: #ffffff; --btn-danger: #dc3545;
  }
  body { font-family: system-ui, -apple-system, sans-serif; margin: 0; padding: 12px; background: var(--bg); color: var(--fg); font-size: 15px; line-height: 1.4; }
  h1 { font-size: 1.3em; margin: 0 0 10px; }
  h2 { font-size: 1.1em; margin: 15px 0 8px; }
  #log { background: var(--panel); padding: 8px; border-radius: 6px; font-family: monospace; font-size: 11px; max-height: 100px; overflow-y: auto; white-space: pre-wrap; border: 1px solid var(--border); }
  table { border-collapse: collapse; margin-top: 10px; width: 100%; font-size: 13px; }
  th, td { border: 1px solid var(--border); padding: 6px 8px; text-align: left; vertical-align: top; }
  th { background: #eee; position: sticky; top: 0; }
  .green { background: var(--green); } .yellow { background: var(--yellow); } .red { background: var(--red); } .blue { background: var(--blue); }
  .good { font-weight: bold; background: var(--good); }
  a { color: var(--btn); text-decoration: none; }
  #summary { margin-top: 10px; padding: 10px; background: #eef; border-radius: 6px; font-size: 14px; }
  #chartWrap { margin-top: 20px; display: none; }
  canvas { border: 1px solid var(--border); background: #fff; width: 100%; height: auto; }
  .legend { font-size: 12px; margin-bottom: 8px; display: flex; flex-wrap: wrap; gap: 5px; }
  .legend span { padding: 2px 6px; border-radius: 4px; }
  .panel { margin: 10px 0; padding: 10px; background: var(--panel); border-radius: 6px; border: 1px solid var(--border); }
  .panel label { display: block; margin-bottom: 8px; font-weight: bold; }
  .panel select, .panel input[type="text"], .panel input[type="number"] { width: 100%; padding: 8px; border-radius: 4px; border: 1px solid var(--border); font-size: 15px; box-sizing: border-box; margin-top: 4px; }
  .hidden { display: none !important; }
  
  .btn-row { display: flex; gap: 10px; margin-top: 10px; }
  button { flex: 1; padding: 14px; border: none; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; color: #fff; }
  button#start { background: var(--btn); }
  button#cancel { background: var(--btn-danger); }
  button:disabled { opacity: 0.6; cursor: default; }

  #progressWrap { margin-top: 12px; display: none; }
  #progressBarContainer { background: #eee; border-radius: 6px; height: 16px; border: 1px solid var(--border); overflow: hidden; }
  #progressBar { background: var(--btn); height: 100%; width: 0%; transition: width 0.2s; }
  #progressText { font-size: 13px; color: #555; text-align: center; margin-top: 6px; font-weight: bold; }

  #resultWrap { display: none; margin-top: 15px; }
  .icon-cell img { width: 24px; height: 24px; vertical-align: middle; margin-right: 5px; border-radius: 4px; }

  .settings-panel { margin-top: 30px; padding: 15px; background: #f4f4f4; border-radius: 6px; font-size: 13px; border-top: 2px solid var(--border); }
  .settings-panel label { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-weight: normal; cursor: pointer; }
  .settings-panel input[type="checkbox"] { width: 18px; height: 18px; }

  @media (max-width: 600px) {
    .col-hide-mobile { display: none; }
    th, td { padding: 4px 5px; font-size: 12px; }
  }
</style>
</head>
