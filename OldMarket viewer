<script>
const VERSION = "1.2";
const SITE = "https://ilyamarket.site/index.php?mode=";
const MODES = { games: "games", apps: "apps" };
const BIG_PAGE = 999999;
// Версионные ключи кэша
const CACHE_KEY = `oldmarket_cache_${VERSION}`;
const PREFS_KEY = `oldmarket_prefs_${VERSION}`;

const PRESETS = {
  x8: { name:"Xperia X8/W8", apiMax:8, armv6:true }, x10: { name:"Xperia X10", apiMax:10, armv6:false },
  galaxys: { name:"Galaxy S", apiMax:10, armv6:false }, galaxys2: { name:"Galaxy S II", apiMax:16, armv6:false },
  galaxys3: { name:"Galaxy S III", apiMax:19, armv6:false }, xperiaj: { name:"Xperia J", apiMax:16, armv6:false },
  xperiae: { name:"Xperia E", apiMax:16, armv6:false }, htcdesirehd: { name:"HTC Desire HD", apiMax:10, armv6:false },
  any: { name:"Любой", apiMax:22, armv6:false }
};

const GENRE_MAP = [
  [/asphalt/i,"Гонки"],[/real racing/i,"Гонки"],[/need for speed/i,"Гонки"],[/the sims/i,"Симуляторы"],[/plague inc/i,"Симуляторы"],[/subway surf/i,"Аркады"],[/angry birds/i,"Аркады"],[/cut the rope/i,"Головоломки"],[/candy crush/i,"Головоломки"],[/modern combat/i,"Экшн"],[/gta/i,"Экшн"],[/minecraft/i,"Экшн"],[/xcom/i,"Стратегии"],[/final fantasy/i,"RPG"],[/fifa/i,"Спорт"],[/chess/i,"Настольные"],[/root explorer/i,"Инструменты"],[/total commander/i,"Инструменты"],[/youtube/i,"Мультимедиа"],[/tiktok/i,"Социальные"],[/telegram/i,"Связь"],[/vk/i,"Социальные"]
];
function detectGenre(name, desc = ""){ for (const [re, genre] of GENRE_MAP) if (re.test(name) || (desc && re.test(desc))) return genre; return null; }

let cache = { games: { pages: {} }, apps: { pages: {} } };
let prefs = { genreStats: {}, optTegra: false };

function loadData() {
  try {
    const c = localStorage.getItem(CACHE_KEY); if (c) cache = JSON.parse(c);
    const p = localStorage.getItem(PREFS_KEY); if (p) prefs = { ...prefs, ...JSON.parse(p) };
  } catch (e) { console.log("Ошибка загрузки"); }
}
function saveCache() { localStorage.setItem(CACHE_KEY, JSON.stringify(cache)); }
function savePrefs() { localStorage.setItem(PREFS_KEY, JSON.stringify(prefs)); }

function trackGenreClick(genre) { if (!genre || genre === "—") return; prefs.genreStats[genre] = (prefs.genreStats[genre] || 0) + 1; savePrefs(); }

const $ = id => document.getElementById(id);
const logEl = $("log");
function log(m){ logEl.textContent += m+"\n"; logEl.scrollTop = logEl.scrollHeight; }
const sleep = ms => new Promise(r => setTimeout(r, ms));

function updatePresetInfo(){
  const k = $("preset").value;
  if (k === "custom") { $("customPanel").classList.remove("hidden"); return; }
  $("customPanel").classList.add("hidden");
}
$("preset").addEventListener("change", updatePresetInfo);
$("cArm").addEventListener("change", renderTable);
$("cApi").addEventListener("change", renderTable);
$("optTegra").checked = prefs.optTegra;
$("optTegra").addEventListener("change", (e) => { prefs.optTegra = e.target.checked; savePrefs(); renderTable(); });

function getPreset(){
  const k = $("preset").value;
  if (k === "custom") return { name: "Custom", apiMax: parseInt($("cApi").value, 10), armv6: $("cArm").value === "v6" };
  return { key:k, ...PRESETS[k] };
}

// ---------- Обычный счетчик (плавный перебор цифр) ----------
function animateValue(elId, start, end) {
  const obj = document.getElementById(elId);
  if (!obj) return;
  if (start === end) { obj.textContent = end; return; }

  const range = end - start;
  const duration = 400; // мс
  const startTime = performance.now();

  function update(currentTime) {
    const elapsed = currentTime - startTime;
    const progress = Math.min(elapsed / duration, 1);
    // easeOutQuad для плавности
    const easeOut = 1 - (1 - progress) * (1 - progress);
    const current = Math.floor(start + range * easeOut);
    
    obj.textContent = current;

    if (progress < 1) {
      requestAnimationFrame(update);
    } else {
      obj.textContent = end;
    }
  }
  requestAnimationFrame(update);
}

// ---------- Состояние ----------
const seen = new Set();
const all = [];
let total=0, okPages=0, failPages=0, newGames=0, cachedGames=0;
let isCancelled = false;
const currentValues = { total:0, pagesOk:0, pagesFail:0, matching:0, good:0, armv6:0, yellow:0, api4:0, api7:0, api8:0, api10:0, api14:0 };

// ---------- Фильтры ----------
const BETA_RE = /\b(beta|alpha|demo|lite|preview|test|early access|бета|альфа|демо|тест)\b/i;
function isFiltered(name) {
  if (/minecraft.*alpha/i.test(name)) return false;
  if (BETA_RE.test(name)) return true;
  if (!prefs.optTegra && /\bTHD\b/i.test(name)) return true;
  return false;
}

async function fetchWithTimeout(url, ms){
  const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), ms);
  try {
    const r = await fetch(url, { credentials:"omit", signal: ctrl.signal }); clearTimeout(t);
    if (!r.ok) throw new Error("HTTP " + r.status);
    return { ok:true, text: await r.text(), url: r.url };
  } catch (e) { clearTimeout(t); return { ok:false }; }
}

async function fetchPageSmart(mode, page, pIndex, totalPages){
  const url = SITE + MODES[mode] + "&page=" + page;
  let maxAttempts = 3, timeoutMs = 5000;
  if (pIndex < 5) { maxAttempts = 5; timeoutMs = 7000; } 
  if (failPages > 3) { maxAttempts = Math.max(2, maxAttempts - 1); }

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    if (isCancelled) return null;
    const res = await fetchWithTimeout(url, timeoutMs);
    if (res.ok) return res.text;
    try {
      const proxy = "https://api.allorigins.win/raw?url=" + encodeURIComponent(url);
      const res2 = await fetchWithTimeout(proxy, timeoutMs);
      if (res2.ok) return res2.text;
    } catch {}
    await sleep(500);
  }
  return null;
}

function detectFromText(html){
  const m = html.match(/Страница\s+\d+\s+из\s+(\d+)/i);
  if (m) return parseInt(m[1], 10);
  const m2 = html.match(/\bиз\s+(\d+)\b/i);
  if (m2) return parseInt(m2[1], 10);
  return null;
}

async function determineLastPage(mode){
  const r1 = await fetchPageSmart(mode, 1, 1, 100);
  if (!r1) return null;
  const fromText = detectFromText(r1);
  if (fromText) return fromText;
  const r2 = await fetchPageSmart(mode, BIG_PAGE, 1, 100);
  if (!r2) return null;
  return detectFromText(r2);
}

function parseItems(html, pageNum){
  try {
    const doc = new DOMParser().parseFromString(html, "text/html");
    const lines = (doc.body ? doc.body.innerText : "").split("\n").map(s=>s.trim()).filter(Boolean);
    const items = [];
    for (let i=0;i<lines.length;i++){
      const m = lines[i].match(/^API\s+(\d+)\s*\(/);
      if (!m) continue;
      const api = parseInt(m[1],10);
      let name=null, rating=null;
      for (let j=i-1;j>=0 && j>=i-6;j--){
        const l=lines[j];
        const rm=l.match(/^Рейтинг:\s*([\d.]+)/);
        if (rm){ rating=parseFloat(rm[1]); continue; }
        if (/^Скачиваний:/.test(l)||/^API\s/.test(l)) continue;
        name=l; break;
      }
      if (name) items.push({ name, rating, api, foundOnPage: pageNum });
    }
    return items;
  } catch (e) { return []; }
}

const KNOWN_ARMV7 = [/minecraft/i,/subway surf/i,/geometry dash/i,/plants vs zombies/i,/temple run/i,/cut the rope/i,/fruit ninja/i,/angry birds/i,/doodle jump/i,/hungry shark/i,/modern combat/i,/real racing/i,/need for speed/i,/asphalt/i];
const KNOWN_X8_WORK = [/cuttheburmalda/i,/burmaldamods/i,/peKORA/i,/говорящий бен/i,/говорящий том/i,/говорящая анджела/i,/говорящий ларри/i,/говорящий санта/i,/talking roby/i,/talking tom bubble/i,/retro brawl/i,/exploration/i,/rover craft/i,/doodle army/i,/джинджер/i,/говорящий хиппо/i,/angry viking/i,/train crisis/i,/inertia/i,/escape velocity/i];
function looksHeavy(n){ return /3d|hd|race|racing|shooter|fps|mmo|online|battle royale|pubg|asphalt|need for speed|modern combat/i.test(n.toLowerCase()); }
function classifyArmv6(name, api){
  if (api>8) return "red"; if (api<8) return looksHeavy(name)?"blue":"green";
  for (const re of KNOWN_ARMV7) if (re.test(name)) return "red";
  for (const re of KNOWN_X8_WORK) if (re.test(name)) return "green";
  if (looksHeavy(name)) return "yellow"; return "blue";
}

function armLabel(a){ return a==="green"?"🟢 пойдёт":a==="yellow"?"🟡 может":a==="red"?"🔴 нет":"🔵 ?"; }
function smartSort(a, b) {
  const isDigitSym = (str) => /^[^a-zA-Zа-яА-Я]/.test(str); const isEng = (str) => /^[a-zA-Z]/.test(str);
  const aN = a.name.trim(), bN = b.name.trim();
  if (isDigitSym(aN) && !isDigitSym(bN)) return -1; if (!isDigitSym(aN) && isDigitSym(bN)) return 1;
  if (isEng(aN) && !isEng(bN)) return -1; if (!isEng(aN) && isEng(bN)) return 1;
  return aN.localeCompare(bN);
}

function renderTable(){
  const mode = $("mode").value; const category = $("category").value; const preset = getPreset();
  const searchQ = $("searchInput").value.toLowerCase().trim(); const sortBy = $("sortSelect").value;

  const thArmv6 = $("thArmv6");
  if (preset.armv6) thArmv6.classList.remove("hidden"); else thArmv6.classList.add("hidden");

  const tb = document.querySelector("#result tbody"); tb.innerHTML = "";
  let filtered = all.filter(g => g.api <= preset.apiMax && (category === "all" || g.genre === category));
  if (searchQ) filtered = filtered.filter(g => g.name.toLowerCase().includes(searchQ));
  if (sortBy === "rating") filtered.sort((a,b) => (b.rating||0) - (a.rating||0));
  else if (sortBy === "name") filtered.sort(smartSort);

  for (const g of filtered) {
    const tr = document.createElement("tr");
    tr.className = g.arm === "green" ? "green" : g.arm === "yellow" ? "yellow" : g.arm === "red" ? "red" : "blue";
    const r = g.rating!=null ? g.rating.toFixed(1) : "—"; const star = (g.rating||0)>=4 ? " ⭐" : "";
    let armTd = preset.armv6 ? `<td>${armLabel(g.arm)}</td>` : "";

    tr.innerHTML = `
      <td class="${g.rating>=4?'good':''}" onclick="trackGenreClick('${g.genre || ""}')">${g.name}${star}</td>
      <td class="col-hide-mobile">${g.genre || "—"}</td>
      <td>${r}</td>
      <td>${g.api}</td>
      ${armTd}
      <td><a href="${SITE + MODES[mode] + "&page=" + g.foundOnPage}" target="_blank">стр. ${g.foundOnPage}</a></td>
    `;
    tb.appendChild(tr);
  }
}

function updateRecommended(preset) {
  const wrap = $("recommendedWrap"); const tb = $("recBody");
  if (Object.keys(prefs.genreStats).length === 0) { wrap.classList.add("hidden"); return; }

  let topGenre = null, maxCount = 0;
  for (const [g, count] of Object.entries(prefs.genreStats)) if (count > maxCount) { maxCount = count; topGenre = g; }
  
  if (!topGenre) { wrap.classList.add("hidden"); return; }
  const recs = all.filter(g => g.genre === topGenre && g.api <= preset.apiMax).slice(0, 5); 

  if (recs.length === 0) { wrap.classList.add("hidden"); return; }
  wrap.classList.remove("hidden"); tb.innerHTML = "";
  for (const g of recs) {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${g.name}</td><td>${g.genre}</td><td>${g.rating ? g.rating.toFixed(1) : "—"}</td><td>${g.api}</td><td>стр. ${g.foundOnPage}</td>`;
    tb.appendChild(tr);
  }
}

function updateSummary(preset, category, mode, newG = 0, cachedG = 0){
  const summaryEl = $("summary");
  summaryEl.style.display = "block";

  let matching = all.filter(g => g.api <= preset.apiMax);
  if (category !== "all") matching = matching.filter(g => g.genre === category);
  const good = matching.filter(g => (g.rating||0)>=4);
  const green = matching.filter(g => g.arm==="green");
  const yellow = matching.filter(g => g.arm==="yellow");

  const api4 = matching.filter(g => g.api <= 4).length;
  const api7 = matching.filter(g => g.api <= 7).length;
  const api8 = matching.filter(g => g.api <= 8).length;
  const api10 = matching.filter(g => g.api <= 10).length;
  const api14 = matching.filter(g => g.api <= 14).length;

  if (summaryEl.innerHTML === "") {
    let html = `<b>Раздел:</b> ${mode==="games"?"Игры":"Приложения"} | <b>Телефон:</b> ${preset.name}<br>`;
    html += `Страниц: <span id="scOk"></span> ок, <span id="scFail"></span> ошибок<br>`;
    html += `Уникальных: <b><span id="scTotal"></span></b> (кэш: <span id="scCached"></span>, новых: <span id="scNew"></span>)<br>`;
    html += `Подходят: <b><span id="scMatching"></span></b> | Хорошие: <b><span id="scGood"></span></b><br>`;
    
    if (preset.armv6) {
      html += `🟢 ARMv6: <b><span id="scGreen"></span></b> | 🟡 Может: <b><span id="scYellow"></span></b><br>`;
    } else {
      html += `<br><b>Статистика по API:</b><br>`;
      html += `≤ 1.6 (API 4): <b><span id="scApi4"></span></b><br>`;
      html += `≤ 2.1 (API 7): <b><span id="scApi7"></span></b><br>`;
      html += `≤ 2.2 (API 8): <b><span id="scApi8"></span></b><br>`;
      html += `≤ 2.3 (API 10): <b><span id="scApi10"></span></b><br>`;
      html += `≤ 4.0 (API 14): <b><span id="scApi14"></span></b><br>`;
    }
    summaryEl.innerHTML = html;
  }

  if ($("scOk")) {
    animateValue("scOk", currentValues.pagesOk, okPages); animateValue("scFail", currentValues.pagesFail, failPages);
    animateValue("scTotal", currentValues.total, total); animateValue("scCached", currentValues.cached, cachedG);
    animateValue("scNew", currentValues.new, newG); animateValue("scMatching", currentValues.matching, matching.length);
    animateValue("scGood", currentValues.good, good.length);
    
    if (preset.armv6) {
      animateValue("scGreen", currentValues.armv6, green.length); animateValue("scYellow", currentValues.yellow || 0, yellow.length);
    } else {
      animateValue("scApi4", currentValues.api4, api4); animateValue("scApi7", currentValues.api7, api7);
      animateValue("scApi8", currentValues.api8, api8); animateValue("scApi10", currentValues.api10, api10);
      animateValue("scApi14", currentValues.api14, api14);
    }
  }

  currentValues.pagesOk = okPages; currentValues.pagesFail = failPages; currentValues.total = total;
  currentValues.cached = cachedG; currentValues.new = newG; currentValues.matching = matching.length;
  currentValues.good = good.length;
  if (preset.armv6) {
    currentValues.armv6 = green.length; currentValues.yellow = yellow.length;
  } else {
    currentValues.api4 = api4; currentValues.api7 = api7; currentValues.api8 = api8;
    currentValues.api10 = api10; currentValues.api14 = api14;
  }
}

async function run(){
  const mode = $("mode").value; const category = $("category").value; const preset = getPreset();
  $("start").disabled = true; $("cancel").classList.remove("hidden");
  $("progressWrap").style.display = "block"; $("progressBar").style.width = "0%"; $("progressBar").style.background = "var(--header-bg)";
  $("progressText").textContent = "Определение страниц..."; $("resultWrap").classList.add("hidden");
  $("summary").style.display = "none"; $("summary").innerHTML = "";

  logEl.textContent = ""; seen.clear(); all.length = 0;
  total=0; okPages=0; failPages=0; newGames=0; cachedGames=0; isCancelled = false;
  for (let key in currentValues) currentValues[key] = 0;

  const lastPage = await determineLastPage(mode);
  if (!lastPage || isCancelled){ $("start").disabled = false; $("cancel").classList.add("hidden"); return; }
  if (!cache[mode].pages) cache[mode].pages = {};

  for (let p=1; p<=lastPage; p++){
    if (isCancelled) break;
    const pageKey = "p" + p; let items = [], isCached = false;
    if (cache[mode].pages[pageKey]) { items = cache[mode].pages[pageKey]; isCached = true; }
    else {
      log(`→ ${p}/${lastPage}...`);
      const html = await fetchPageSmart(mode, p, p, lastPage);
      if (!html){ failPages++; await sleep(200); continue; }
      items = parseItems(html, p);
      if (!items.length){ failPages++; await sleep(200); continue; }
      cache[mode].pages[pageKey] = items;
    }
    okPages++;
    for (const g of items){
      const key=g.name.toLowerCase().trim(); if (seen.has(key)) continue; seen.add(key);
      if (isFiltered(g.name)) continue;
      g.genre = detectGenre(g.name); g.arm = classifyArmv6(g.name, g.api);
      all.push(g); total++; if (isCached) cachedGames++; else newGames++;
    }
    const percent = Math.round((p / lastPage) * 100);
    $("progressBar").style.width = percent + "%"; $("progressText").textContent = `Сканирование... ${p} / ${lastPage} (${percent}%)`;
    updateSummary(preset, category, mode, newGames, cachedGames);
    if (!isCached) await sleep(200);
  }
  
  // Сохраняем кэш даже при отмене
  saveCache();
  
  $("resultWrap").classList.remove("hidden"); 
  renderTable(); 
  updateRecommended(preset);
  updateSummary(preset, category, mode, newGames, cachedGames);
  
  $("start").disabled = false; $("cancel").classList.add("hidden");
  $("progressBar").style.width = "100%"; $("progressBar").style.background = "#27ae60"; $("progressText").textContent = `Готово!`;
}

$("start").addEventListener("click", run);
$("cancel").addEventListener("click", () => { 
  isCancelled = true; 
  log("🛑 Отмена..."); 
  saveCache(); // Принудительное сохранение при отмене
});
$("searchInput").addEventListener("input", renderTable); $("sortSelect").addEventListener("change", renderTable);
$("mode").addEventListener("change", renderTable); $("category").addEventListener("change", renderTable); $("preset").addEventListener("change", renderTable);

$("clearCache").addEventListener("click", () => {
  if (confirm("Очистить весь кэш? Придется заново сканировать страницы.")) {
    localStorage.removeItem(CACHE_KEY);
    cache = { games: { pages: {} }, apps: { pages: {} } };
    alert("Кэш очищен!");
  }
});

loadData(); updatePresetInfo();
</script>
